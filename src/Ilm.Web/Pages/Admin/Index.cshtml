@page
@model Ilm.Web.Pages.Admin.IndexModel
@{ var d = Model.Config.Document; ViewData["Title"] = "Administration"; }
<h1>Administration <small class="muted">active configuration v@Model.Config.Version</small></h1>
<p class="actions-row"><a class="btn" href="/Admin/Configuration">Configuration versions</a> <a class="btn secondary" href="/Admin/Flags">Feature flags</a> <a class="btn secondary" href="/Admin/Protection">Protection additions</a> <a class="btn secondary" href="/Admin/Feasibility">Okta-to-AD feasibility</a> <a class="btn secondary" href="/Admin/Health">Connector health</a></p>
<p class="muted">Every change is a new configuration version: proposed by a Configuration Administrator, approved by a different Security Approver, then activated. Nothing here can remove the hardcoded Tier 0 floor or enable Tier 0 management.</p>

<h2>Directory connectors</h2>
<table class="grid"><thead><tr><th>ID</th><th>Forest / domain</th><th>Role</th><th>Mode</th><th>Implementation</th><th>DCs</th><th>Transport</th></tr></thead><tbody>
@foreach (var c in d.Connectors) { <tr><td>@c.Id</td><td>@c.ForestDnsName / @c.DomainDnsName</td><td>@c.Role</td><td>@c.Mode</td><td>@c.Implementation</td><td>@string.Join(", ", c.DomainControllers)</td><td>@(c.UseLdaps ? "LDAPS (validated)" : "Kerberos sign+seal")</td></tr> }
</tbody></table>

<h2>OU scopes (by objectGUID)</h2>
<table class="grid"><thead><tr><th>ID</th><th>Connector</th><th>objectGUID</th><th>Resolved DN now</th></tr></thead><tbody>
@foreach (var s in Model.Scopes) { <tr><td>@s.ScopeId</td><td>@s.ConnectorId</td><td>@s.OuGuid</td><td>@(s.DistinguishedName ?? "UNRESOLVED (inactive)")</td></tr> }
</tbody></table>

<h2>Authority rules</h2>
<table class="grid compact"><thead><tr><th>Population</th><th>Entity</th><th>Wave</th><th>Account type</th><th>Action</th><th>Attribute set</th><th>Owner</th><th>Containment owner</th><th>Strategy</th></tr></thead><tbody>
@foreach (var r in Model.Config.AuthorityRules.OrderBy(r => r.Population).ThenBy(r => r.LifecycleAction).ThenBy(r => r.AttributeSet))
{
    <tr><td>@r.Population</td><td>@(r.BusinessEntity ?? "*")</td><td>@(r.MigrationWave ?? "*")</td><td>@(r.AccountType?.ToString() ?? "*")</td><td>@r.LifecycleAction</td><td>@r.AttributeSet</td><td>@r.AuthoritativeSystem</td><td>@r.ContainmentOwner</td><td>@r.ProvisioningStrategy</td></tr>
}
</tbody></table>

<div class="cards">
<div class="card"><h2>Hardcoded protection floor (not configurable)</h2><ul>@foreach (var f in Ilm.Web.Pages.Admin.IndexModel.Floor) { <li>@f</li> }</ul></div>
<div class="card"><h2>Protection additions</h2>
<table class="grid compact"><thead><tr><th>Match</th><th>Value</th><th>Category</th><th>Source</th></tr></thead><tbody>
@foreach (var p in d.ProtectionAdditions) { <tr><td>@p.MatchOn</td><td>@p.Value</td><td>@p.Category</td><td>@p.Source (@p.SourceReference)</td></tr> }
</tbody></table></div>
<div class="card"><h2>Role mappings (immutable Okta group IDs)</h2>
<p class="muted">Resolution: @d.RoleResolution.Mode, cache @d.RoleResolution.CacheSeconds s (max 300; bypassed for commits).</p>
<table class="grid compact"><thead><tr><th>Group ID</th><th>Role</th><th>Scopes</th></tr></thead><tbody>
@foreach (var m in d.RoleMappings) { <tr><td>@m.OktaGroupId</td><td>@m.Role</td><td>@string.Join(", ", m.ScopeIds)</td></tr> }
</tbody></table></div>
<div class="card"><h2>SafelyContained policy</h2><dl class="kv">
    <dt>Authentication verified</dt><dd>@d.LifecyclePolicies.SafelyContained.RequireAuthenticationContainmentVerified (always)</dd>
    <dt>Directory disable verified</dt><dd>@d.LifecyclePolicies.SafelyContained.RequireDirectoryDisableVerified (always)</dd>
    <dt>All links resolved</dt><dd>@d.LifecyclePolicies.SafelyContained.RequireAllIdentityLinksResolved</dd>
    <dt>Okta action</dt><dd>@d.LifecyclePolicies.SafelyContained.OktaAction (revoke OAuth tokens: @d.LifecyclePolicies.SafelyContained.RevokeOktaOAuthTokens)</dd>
    @foreach (var (s, req) in d.LifecyclePolicies.SafelyContained.SessionRequirements) { <dt>@s sessions</dt><dd>@req</dd> }
    <dt>Emergency directory override</dt><dd>@d.LifecyclePolicies.SafelyContained.AllowEmergencyDirectoryOverride</dd>
</dl></div>
<div class="card"><h2>Provisioning strategies</h2><table class="grid compact"><tbody>@foreach (var (k, e) in Model.Strategies) { <tr><td>@k</td><td>@(e ? "Enabled" : "Disabled")</td></tr> }</tbody></table></div>
<div class="card"><h2>Feature flags</h2><table class="grid compact"><tbody>@foreach (var f in Enum.GetValues<Ilm.Domain.Configuration.Feature>()) { <tr><td>@f</td><td>@(Model.Config.IsEnabled(f) ? "Enabled" : "Disabled")</td></tr> }</tbody></table></div>
</div>
