@page
@model Ilm.Web.Pages.Users.IndexModel
@{ ViewData["Title"] = "Users"; }
<h1>Users</h1>
<p class="muted">Searches run on the directory, server-side, from each OU scope you hold. Input is LDAP-escaped.</p>
<form method="get"><input type="search" name="q" value="@Model.Q" placeholder="sAMAccountName, name, mail or UPN prefix" /> <button type="submit">Search</button></form>
<table class="grid"><thead><tr><th>Account</th><th>Display name</th><th>Forest</th><th>Enabled</th><th>DN</th></tr></thead><tbody>
@foreach (var u in Model.Results)
{
    <tr><td><a href="/Users/Details?connector=@u.ConnectorId&id=@u.ObjectGuid">@u.SamAccountName</a></td><td>@u.DisplayName</td><td>@u.ForestId</td><td>@(u.IsDisabled ? "Disabled" : "Enabled")</td><td><small>@u.DistinguishedName</small></td></tr>
}
</tbody></table>
