{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "ConnectionStrings": {
    "Ilm": "Data Source=App_Data/ilm-dev.db",
    "IlmMigration": "Data Source=App_Data/ilm-dev.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Https": { "Url": "https://localhost:5001" }
    }
  },
  "Ilm": {
    "Database": { "Provider": "Sqlite" },
    "Authentication": {
      "Mode": "MockOidc",
      "Issuer": "https://localhost:5001/mock-oidc",
      "ClientId": "ilm-portal-dev",
      "PublicBaseUrl": "https://localhost:5001",
      "AllowedRedirectUris": [ "https://localhost:5001/signin-oidc" ]
    },
    "Okta": { "Mode": "Mock", "OrgUrl": "https://okta.example.test" },
    "Audit": { "JsonlSinkPath": "App_Data/audit-forwarded.jsonl", "DevelopmentKeyPath": "App_Data/audit-dev.key" },
    "Platform": {
      "RuntimeIdentitySids": [ "S-1-5-21-1000000001-1000000002-1000000003-1201" ],
      "HostComputerSids": [ "S-1-5-21-1000000001-1000000002-1000000003-1202" ],
      "HostDnsNames": [ "ilm-web01.corp.example.test" ],
      "DatabaseServiceIdentitySids": [ "S-1-5-21-1000000001-1000000002-1000000003-1203" ],
      "BreakGlassSids": [ "S-1-5-21-1000000001-1000000002-1000000003-1204" ],
      "ManagedPasswordRetrieverSids": [ "S-1-5-21-1000000001-1000000002-1000000003-1102" ],
      "ManagedPasswordRetrieversVerified": true
    },
    "Sessions": { "UseDevelopmentMocks": true },
    "Development": { "MigrateOnStartup": true, "SeedOnStartup": true }
  }
}
